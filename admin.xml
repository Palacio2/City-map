        if (type === 'warning') return 'warning';
        if (type === 'error') return 'danger';
        return 'primary';
    };

    const getTypeIcon = (type) => {
        if (type === 'success') return FaCheckCircle;
        if (type === 'warning') return FaExclamationTriangle;
        if (type === 'error') return FaTimesCircle;
