          {hero.title}
        </h1>
        <p className="text-xl md:text-2xl text-textSecondary font-light leading-relaxed max-w-3xl mx-auto">
          {hero.subtitle}
        </p>
      </section>

      <div className="w-full max-w-7xl px-4 sm:px-6 lg:px-8 space-y-24 relative z-10">
        
