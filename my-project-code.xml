  const rawQuestions = t(`faq.questions.${activeCategory}`, { returnObjects: true });
  
  const questions = useMemo(() => {
    if (typeof rawQuestions === 'string') {
      try {
        return JSON.parse(rawQuestions);
      } catch (e) {
        return [];
      }
