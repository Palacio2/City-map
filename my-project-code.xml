<file path="components/stats/components/DistrictComparison/ComparisonTable.tsx">
import React, { useMemo } from 'react';
import { useTranslation } from 'react-i18next';
import { FaMapMarkerAlt, FaStar } from 'react-icons/fa';
import { DISTRICT_CATEGORIES } from '@config/districtFields'; 
import { getValue, formatPrice, formatNumber } from '@utils/formatters';
import { TransformedDistrict } from '@utils/dataTransformers';

const safeStringify = (val: unknown): string => {
  if (val === null || val === undefined) return '-';
  if (typeof val === 'string' || typeof val === 'number' || typeof val === 'boolean') return val.toString();
  return '-';
};

const FormattedRating = ({ value }: { value: unknown }) => {
  if (!value) return <>{'-'}</>;
  return (
    <span className="flex items-center justify-center gap-1 font-bold text-accent">
      {Number(value).toFixed(1)} <FaStar className="text-xs" />
    </span>
  );
};

interface RowDef {
  type?: 'header';
  title?: string;
  label?: string;
  key?: string;
  format?: (v: unknown, d: TransformedDistrict) => React.ReactNode;
}

const buildCategoryRows = (catKey: string, config: any, t: any): RowDef[] => {
  const catName = t(`common:categories.${catKey}`);
  const catHeader: RowDef = { type: 'header', title: catName };
  
  const ratingRow: RowDef = { 
    label: `${catName} Rating`, 
    key: `filterData.${catKey}.rating`, 
    format: (v) => <FormattedRating value={v} /> 
  };
  
  const fieldRows: RowDef[] = Object.entries(config.fields).map(([fieldKey, fieldConfig]) => ({
    label: t(`common:fields.${fieldKey}`),
    key: `filterData.${catKey}.${fieldKey}`,
    format: (v, d) => {
      const fType = (fieldConfig as any).type;
      if (fType === 'price') return formatPrice(Number(v), String(d.country));
      if (fType === 'number') return formatNumber(Number(v));
      if (fType === 'boolean') {
        return v ? t('common:enums.yes', { defaultValue: 'Yes' }) : t('common:enums.no', { defaultValue: 'No' });
      }
      return safeStringify(v);
    }
  }));

  return [catHeader, ratingRow, ...fieldRows];
};

export default function ComparisonTable({ districts }: Readonly<{ districts: TransformedDistrict[] }>) {
  const { t } = useTranslation(['db', 'common']);

  const rows: RowDef[] = useMemo(() => {
    if (!districts?.length) return [];

    const generalSection: RowDef[] = [
      { type: 'header', title: t('common:categories.finance_population') },
      { 
        label: `${t('common:fields.propertyPricePerSqm')} (${t('common:units.sqm')})`, 
        key: 'filterData.utilities.propertyPricePerSqm', 
        format: (v, d) => formatPrice(Number(v), String(d.country)) 
      },
      { 
        label: t('common:fields.average_rent_price'), 
        key: 'filterData.general.average_rent_price', 
        format: (v, d) => formatPrice(Number(v), String(d.country)) 
      },
      { 
        label: t('common:fields.averageSalary'), 
        key: 'filterData.general.averageSalary', 
        format: (v, d) => formatPrice(Number(v), String(d.country)) 
      },
      { 
        label: t('common:fields.population'), 
        key: 'filterData.general.population', 
        format: (v) => formatNumber(Number(v)) 
      },
      { 
        label: t('common:fields.unemploymentRate'), 
        key: 'filterData.general.unemploymentRate', 
        format: (v) => (v !== null && v !== undefined ? `${v}%` : '-') 
      }
    ];

    const categorySections = Object.entries(DISTRICT_CATEGORIES)
      .filter(([key]) => key !== 'general')
      .flatMap(([catKey, config]) => buildCategoryRows(catKey, config, t));

    return [...generalSection, ...categorySections];
  }, [districts, t]);

  if (!districts?.length) return null;

  return (
    <div className="w-full overflow-x-auto bg-surface rounded-2xl border border-borderClient shadow-card custom-scrollbar">
      <table className="w-full border-collapse text-left min-w-[600px]">
        <thead>
          <tr>
            <th className="sticky left-0 z-20 bg-body border-r border-b border-borderClient min-w-[140px] max-w-[140px] md:min-w-[200px] md:max-w-[250px] p-4 shadow-[2px_0_5px_rgba(0,0,0,0.05)]"></th>
            {districts.map((d, i) => (
              <th key={String(d.id || d.name)} className="bg-body border-b border-borderClient p-4 min-w-[180px] md:min-w-[220px] text-center align-top relative">
                {i > 0 && <div className="absolute left-0 top-4 bottom-4 w-px bg-borderClient/50"></div>}
                <div className="flex flex-col items-center gap-2">
                  <div className="w-14 h-14 md:w-16 md:h-16 rounded-full overflow-hidden border-2 border-accent bg-hover shrink-0">
                    {d.photo_url ? (
                      <img src={d.photo_url as string} alt={String(d.name)} className="w-full h-full object-cover" />
                    ) : (
                      <FaMapMarkerAlt className="w-full h-full p-4 text-textSecondary opacity-50" />
                    )}
                  </div>
                  <div className="flex flex-col">
                    <span className="font-heading font-bold text-[1rem] md:text-[1.15rem] text-textMain leading-tight">{String(d.name)}</span>
                    <span className="text-xs text-textSecondary">{String(d.city)}, {String(d.country)}</span>
                  </div>
                </div>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row, rIdx) => {
            const rowKey = row.key ? `row-${row.key}` : `header-${rIdx}`;

            if (row.type === 'header') {
              return (
                <tr key={rowKey}>
                  <td className="sticky left-0 z-10 bg-body border-r border-b border-borderClient text-left min-w-[140px] max-w-[140px] md:min-w-[200px] md:max-w-[250px] shadow-[2px_0_5px_rgba(0,0,0,0.05)] text-accent font-heading font-bold uppercase tracking-widest px-4 py-3 text-[0.85rem]">{row.title}</td>
                  {districts.map((d) => (
                    <td key={`spacer-${String(d.id || d.name)}`} className="bg-body border-b border-borderClient"></td>
                  ))}
                </tr>
              );
            }

            return (
              <tr key={rowKey} className="group hover:bg-hover transition-colors">
                <td className="sticky left-0 z-10 bg-surface border-r border-b border-borderClient text-left min-w-[140px] max-w-[140px] md:min-w-[200px] md:max-w-[250px] shadow-[2px_0_5px_rgba(0,0,0,0.05)] font-semibold text-textSecondary text-[0.9rem] p-3 md:p-4 align-middle group-hover:bg-hover transition-colors">{row.label}</td>
                {districts.map((d, dIdx) => {
                  const rawVal = row.key ? getValue(d, row.key) : null;
                  
                  let displayVal: React.ReactNode = '-';
                  if (row.format) {
                    displayVal = row.format(rawVal, d);
                  } else {
                    displayVal = safeStringify(rawVal);
                  }
                  
                  return (
                    <td key={`cell-${String(d.id || d.name)}-${row.key}`} className="border-b border-borderClient p-3 md:p-4 text-center align-middle text-[0.95rem] text-textMain font-medium relative">
                      {dIdx > 0 && <div className="absolute left-0 top-3 bottom-3 w-px bg-borderClient/30"></div>}
                      {displayVal}
                    </td>
                  );
                })}
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  );
}
</file>

<file path="components/stats/components/DistrictComparison/DistrictComparisonPage.tsx">
import React, { useState, useEffect } from 'react';
import { Link } from 'react-router-dom';
import { useTranslation } from 'react-i18next';
import { FaArrowLeft, FaPlus, FaTimes, FaFilePdf, FaCheckCircle } from 'react-icons/fa';
import { fetchDistrictsByIds } from '@api/districtsApi'; 
import LocationSelectorModal, { DistrictSelection } from '../PopularDistricts/LocationSelectorModal';
import ComparisonTable from './ComparisonTable';
import PdfReportTemplate from './PdfReportTemplate';
import ExportSettingsModal, { ExportCustomData } from './ExportSettingsModal';
import Loader from '@components/loader/Loader';
import { saveComparison } from '@api/comparisonApi';
import { transformDistrictsForDisplay, TransformedDistrict } from '@utils/dataTransformers';
import { usePdfExport } from '@hooks/usePdfExport'; // ЄДИНИЙ ХУК ДЛЯ PDF

const MAX_SELECTION = 4;
const STORAGE_KEY = 'comparison_selected_districts';

export default function DistrictComparisonPage() {
  const { t } = useTranslation('db');
  
  // Використовуємо наш єдиний хук для PDF експорту
  const { isDownloading, downloadPdf } = usePdfExport('comparison_report');

  const [selectedDistricts, setSelectedDistricts] = useState<DistrictSelection[]>(() => {
    try {
      const saved = sessionStorage.getItem(STORAGE_KEY);
      return saved ? JSON.parse(saved) : [];
    } catch {
      return [];
    }
  });

  const [isModalOpen, setIsModalOpen] = useState(false);
  const [isSaving, setIsSaving] = useState(false);
  const [saveSuccess, setSaveSuccess] = useState(false);
  const [displayDistricts, setDisplayDistricts] = useState<TransformedDistrict[]>([]);
  const [isLoadingData, setIsLoadingData] = useState(false);
  const [isExportModalOpen, setIsExportModalOpen] = useState(false);
  const [exportData, setExportData] = useState<ExportCustomData | null>(null);

  useEffect(() => {
    sessionStorage.setItem(STORAGE_KEY, JSON.stringify(selectedDistricts));
  }, [selectedDistricts]);

  useEffect(() => {
    const loadDistrictData = async () => {
      if (selectedDistricts.length === 0) {
        setDisplayDistricts([]);
        return;
      }
      setIsLoadingData(true);
      try {
        const ids = selectedDistricts.map(d => d.id).filter(id => id) as string[];
        const rawData = await fetchDistrictsByIds(ids);
        const transformed = transformDistrictsForDisplay(rawData);
        
        const mergedData = selectedDistricts.map(sd => {
          const detailedData = Array.isArray(transformed) ? transformed.find(d => String(d.id) === String(sd.id)) : undefined;
          return detailedData || sd as unknown as TransformedDistrict;
        });

        setDisplayDistricts(mergedData);
      } catch (err) {
        console.error(err);
      } finally {
        setIsLoadingData(false);
      }
    };
    loadDistrictData();
  }, [selectedDistricts]);

  const handleAddDistricts = (newSelections: DistrictSelection[]) => {
    setSelectedDistricts(prev => {
      const combined = [...prev, ...newSelections];
      const unique = Array.from(new Map(combined.map(item => [item.id || item.name, item])).values());
      return unique.slice(0, MAX_SELECTION);
    });
    setIsModalOpen(false);
  };

  const removeDistrict = (idOrName: string | number) => {
    setSelectedDistricts(prev => prev.filter(d => (d.id || d.name) !== idOrName));
  };

  const handleSaveComparison = async () => {
    if (selectedDistricts.length < 2) return;
    setIsSaving(true);
    setSaveSuccess(false);
    try {
      const ids = selectedDistricts.map(d => String(d.id)).filter(id => id !== 'undefined');
      await saveComparison(ids);
      setSaveSuccess(true);
      setTimeout(() => setSaveSuccess(false), 3000);
    } catch {
       alert(t('common:error_occurred'));
    } finally {
      setIsSaving(false);
    }
  };

  // Логіка PDF експорту через наш хук
  const handleExportConfirm = (customData: ExportCustomData) => {
    setExportData(customData);
    setIsExportModalOpen(false);
    
    // Чекаємо 500мс, щоб рендеринг прихованого PDF-шаблону оновився логотипом та текстом
    setTimeout(() => {
      downloadPdf('pdf-export-container');
    }, 500);
  };

  return (
    <div className="min-h-[100dvh] bg-body text-textMain py-8 px-4 md:px-8 font-body">
      <div className="max-w-[1400px] mx-auto mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 animate-fadeIn">
        <div className="flex flex-col gap-2">
          <Link to="/profile/stats" className="inline-flex items-center gap-2 text-textSecondary font-heading font-semibold text-[0.85rem] tracking-widest uppercase transition-all w-fit hover:text-accent hover:-translate-x-1 decoration-none">
            <FaArrowLeft /> {t('stats.stats_page.back_to_stats')}
          </Link>
          <h1 className="font-heading text-3xl md:text-[2.5rem] font-bold text-accent m-0">{t('comparison.title')}</h1>
        </div>
        <div className="flex items-center gap-3">
          {saveSuccess && <span className="text-success text-sm font-bold flex items-center gap-1.5 animate-fadeIn"><FaCheckCircle /> {t('comparison.saved')}</span>}
          {selectedDistricts.length >= 2 && (
            <button className="bg-transparent border border-borderClient text-textMain py-2.5 px-5 rounded-lg font-semibold font-heading uppercase tracking-widest cursor-pointer transition-all text-xs hover:bg-hover hover:border-accent hover:text-accent disabled:opacity-50" onClick={handleSaveComparison} disabled={isSaving}>
              {isSaving ? '...' : t('comparison.save_comparison')}
            </button>
          )}
        </div>
      </div>

      <div className="max-w-[1400px] mx-auto bg-surface border border-borderClient rounded-2xl p-5 md:p-8 mb-8 shadow-sm">
        <div className="flex justify-between items-center mb-6 pb-4 border-b border-borderClient">
          <h3 className="font-heading text-lg font-bold text-textMain m-0 uppercase tracking-wide">
            {t('comparison.selected_districts')} <span className="text-textSecondary font-normal ml-2">({selectedDistricts.length}/{MAX_SELECTION})</span>
          </h3>
          <button className="flex items-center gap-2 bg-accent text-white border-none py-2.5 px-5 rounded-lg font-semibold font-heading uppercase tracking-widest cursor-pointer transition-all text-xs hover:bg-accent-hover hover:-translate-y-0.5 hover:shadow-md disabled:opacity-50 disabled:cursor-not-allowed" onClick={() => setIsModalOpen(true)} disabled={selectedDistricts.length >= MAX_SELECTION}>
            <FaPlus /> {t('comparison.add_district')}
          </button>
        </div>

        {selectedDistricts.length === 0 ? (
          <div className="text-center p-12 text-textSecondary border-2 border-dashed border-borderClient rounded-xl bg-body">
             {t('comparison.no_districts_selected')}
          </div>
        ) : (
          <div className="flex flex-wrap gap-4">
            {selectedDistricts.map((d) => (
              <div key={d.id || d.name} className="flex items-center gap-3 bg-body border border-borderClient rounded-xl p-3 pr-4 shadow-sm animate-popIn">
                 <div className="flex flex-col">
                   <span className="font-bold text-textMain text-[0.95rem]">{d.name}</span>
                   <span className="text-xs text-textSecondary">{d.city}, {d.country}</span>
                 </div>
                 <button className="bg-danger/10 text-danger border-none w-8 h-8 rounded-full flex items-center justify-center cursor-pointer transition-all ml-2 hover:bg-danger hover:text-white" onClick={() => removeDistrict(d.id || d.name)}>
                   <FaTimes />
                 </button>
              </div>
            ))}
          </div>
        )}
      </div>

      {selectedDistricts.length >= 1 && (
        <div className="max-w-[1400px] mx-auto animate-slideUp">
          <div className="flex justify-between items-center mb-6">
            <h2 className="font-heading text-2xl font-bold text-textMain m-0">{t('comparison.results')}</h2>
            <button className="flex items-center justify-center gap-2.5 bg-surface text-textMain border border-borderClient py-3 px-6 rounded-md font-semibold font-heading uppercase tracking-widest cursor-pointer transition-all text-[0.85rem] hover:not(:disabled):bg-hover hover:not(:disabled):border-accent hover:not(:disabled):text-accent hover:not(:disabled):-translate-y-0.5 disabled:opacity-60 disabled:cursor-wait w-full sm:w-auto" onClick={() => setIsExportModalOpen(true)} disabled={isDownloading || isLoadingData}>
              {isDownloading ? <Loader size="small" /> : <><FaFilePdf /> {t('comparison.export_pdf')}</>}
            </button>
          </div>
          
          {isLoadingData ? (
             <div className="flex justify-center p-20"><Loader size="large" /></div>
          ) : (
             <ComparisonTable districts={displayDistricts} />
          )}
        </div>
      )}

      {/* Прихований контейнер для експорту PDF з правильним ID */}
      <div style={{ position: 'fixed', top: 0, left: '-10000px', zIndex: -1 }}>
        <div id="pdf-export-container" style={{ width: '794px', background: 'white' }}>
           <PdfReportTemplate districts={displayDistricts} customData={exportData} />
        </div>
      </div>

      {isModalOpen && (
        <LocationSelectorModal 
          onClose={() => setIsModalOpen(false)} 
          onSubmit={handleAddDistricts}
          includeDistrict={true}
          maxSelection={MAX_SELECTION}
          currentCount={selectedDistricts.length}
        />
      )}

      <ExportSettingsModal 
        isOpen={isExportModalOpen}
        onClose={() => setIsExportModalOpen(false)}
        onConfirm={handleExportConfirm}
      />
    </div>
  );
}
