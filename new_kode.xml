import React, { useState, useEffect } from 'react';
import { api } from '../../../../services/api';

export default function FieldsManager() {
    const [fields, setFields] = useState([]);
    const [groups, setGroups] = useState([]);
    const [isModalOpen, setIsModalOpen] = useState(false);
    const [isLoading, setIsLoading] = useState(false);
    const [isEditing, setIsEditing] = useState(false);

    // ВАЖЛИВО: Видалено osm_key та osm_value, залишено лише гнучкий parser_config
    const initialForm = {
        field_code: '', 
        admin_label: '', 
        icon: '📍', 
        data_type: 'integer',
        ui_group: '', 
        source_type: 'osm', 
        parser_config: '{\n  "source": "osm",\n  "osm": {\n    "operator": "OR",\n    "filters": []\n  }\n}',
        ui_component: 'input_number', 
        is_visible_table: true, 
        is_visible_form: true, 
        sort_order: 0
    };
    
    const [formData, setFormData] = useState(initialForm);
    const [jsonError, setJsonError] = useState(null);

    useEffect(() => { fetchData(); }, []);

    const fetchData = async () => {
        try {
            const [fieldsData, groupsData] = await Promise.all([
                api.config.getFields(),
                api.config.getGroups()
            ]);
            setFields(Array.isArray(fieldsData) ? fieldsData : []);
            setGroups(Array.isArray(groupsData) ? groupsData : []);
            
            if (groupsData?.length > 0 && !initialForm.ui_group) {
                initialForm.ui_group = groupsData[0].id;
            }
        } catch (error) { console.error(error); }
    };

    const handleInputChange = (e) => {
        const { name, value, type, checked } = e.target;
        if (name === 'field_code') {
            const safeValue = value.toLowerCase().replace(/[^a-z0-9_]/g, '');
            setFormData({ ...formData, [name]: safeValue });
        } else if (type === 'checkbox') {
            setFormData({ ...formData, [name]: checked });
        } else {
            setFormData({ ...formData, [name]: value });
        }
        
        if (name === 'parser_config') {
            setJsonError(null);
        }
    };

    const handleAddNew = () => { 
        setFormData({ ...initialForm, ui_group: groups[0]?.id || '' }); 
        setIsEditing(false); 
        setJsonError(null);
        setIsModalOpen(true); 
    };

    const handleEdit = (field) => { 
        setFormData({
            ...field,
            parser_config: typeof field.parser_config === 'object' ? JSON.stringify(field.parser_config, null, 2) : field.parser_config
        }); 
        setIsEditing(true); 
        setJsonError(null);
        setIsModalOpen(true); 
    };

    const handleSubmit = async (e) => {
        e.preventDefault();
        setIsLoading(true);
        setJsonError(null);
        
        const payload = { ...formData };
        
        try {
            payload.parser_config = JSON.parse(payload.parser_config || '{}');
        } catch (error) {
            setJsonError("Невалідний JSON у полі Parser Config. Перевірте синтаксис.");
            setIsLoading(false);
            return;
        }

        try {
            if (isEditing) {
                await api.config.updateField(formData.id, payload);
            } else {
                await api.config.createField(payload);
            }
            await fetchData();
            setIsModalOpen(false);
        } catch (error) {
            alert(`Помилка: ${error.message}`);
        } finally { 
            setIsLoading(false); 
        }
    };

    const handleDelete = async (id, code) => {
        if (!window.confirm(`Видалити конфігурацію поля ${code}?`)) return;
        try {
            await api.config.deleteField(id);
            await fetchData();
        } catch (error) { alert(`Помилка видалення: ${error.message}`); }
    };

    return (
        <div className="p-6 max-w-7xl mx-auto">
            <div className="flex justify-between items-center mb-6">
                <h1 className="text-2xl font-bold">Конструктор Полів (Schema Builder)</h1>
                <button onClick={handleAddNew} className="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">+ Створити нове поле</button>
            </div>

            <div className="bg-white shadow rounded-lg overflow-x-auto">
                <table className="min-w-full text-left whitespace-nowrap">
                    <thead className="bg-gray-100">
                        <tr>
                            <th className="px-4 py-3">Порядок</th>
                            <th className="px-4 py-3">Іконка</th>
                            <th className="px-4 py-3">Назва (Адмінка)</th>
                            <th className="px-4 py-3">Код поля</th>
                            <th className="px-4 py-3">Група</th>
                            <th className="px-4 py-3">Джерело</th>
                            <th className="px-4 py-3">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        {fields.sort((a,b) => a.sort_order - b.sort_order).map(field => (
                            <tr key={field.id} className="border-t hover:bg-gray-50">
                                <td className="px-4 py-3 text-gray-500">{field.sort_order}</td>
                                <td className="px-4 py-3 text-xl">{field.icon}</td>
                                <td className="px-4 py-3 font-medium">{field.admin_label}</td>
                                <td className="px-4 py-3 text-gray-500 font-mono text-sm">{field.field_code}</td>
                                <td className="px-4 py-3">
                                    <span className="px-2 py-1 text-xs rounded bg-blue-50 text-blue-700 border border-blue-200">{field.ui_group}</span>
                                </td>
                                <td className="px-4 py-3 text-sm">
                                    <span className="px-2 py-1 text-xs rounded bg-gray-100 uppercase">{field.source_type}</span>
                                </td>
                                <td className="px-4 py-3">
                                    <button onClick={() => handleEdit(field)} className="text-blue-500 hover:text-blue-700 mr-3 font-medium">Змінити</button>
                                    <button onClick={() => handleDelete(field.id, field.field_code)} className="text-red-500 hover:text-red-700 font-medium">Видалити</button>
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>

            {isModalOpen && (
                <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
                    <div className="bg-white p-6 rounded-lg w-full max-w-4xl max-h-[90vh] overflow-y-auto">
                        <h2 className="text-xl font-bold mb-4">{isEditing ? 'Редагувати поле' : 'Створити нову метрику'}</h2>
                        <form onSubmit={handleSubmit} className="space-y-4">
                            
                            <div className="grid grid-cols-1 md:grid-cols-4 gap-4 bg-gray-50 p-4 rounded border">
                                <div>
                                    <label className="block text-sm font-medium text-gray-700">Емодзі (Іконка)</label>
                                    <input required type="text" name="icon" value={formData.icon} onChange={handleInputChange} className="mt-1 block w-full border border-gray-300 rounded p-2 text-center text-xl bg-white" />
                                </div>
                                <div className="md:col-span-2">
                                    <label className="block text-sm font-medium text-gray-700">Відображувана назва (Label)</label>
                                    <input required type="text" name="admin_label" value={formData.admin_label} onChange={handleInputChange} className="mt-1 block w-full border border-gray-300 rounded p-2 bg-white" placeholder="Напр: Кількість шкіл" />
                                </div>
                                <div>
                                    <label className="block text-sm font-medium text-gray-700">Джерело (Source)</label>
                                    <select name="source_type" value={formData.source_type} onChange={handleInputChange} className="mt-1 block w-full border border-gray-300 rounded p-2 bg-white">
                                        <option value="osm">OSM</option>
                                        <option value="api">API (GUS/WAQI)</option>
                                        <option value="scraper">Scraper (Otodom)</option>
                                        <option value="manual">Manual (Ручне)</option>
                                    </select>
                                </div>
                            </div>

                            <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div>
                                    <label className="block text-sm font-medium text-gray-700">Код поля в БД (key)</label>
                                    <input required type="text" name="field_code" value={formData.field_code} onChange={handleInputChange} disabled={isEditing} className="mt-1 block w-full border border-gray-300 rounded p-2 disabled:bg-gray-200 font-mono text-sm" placeholder="schools_count" />
                                </div>
                                <div>
                                    <label className="block text-sm font-medium text-gray-700">Тип даних (БД)</label>
                                    <select name="data_type" value={formData.data_type} onChange={handleInputChange} disabled={isEditing} className="mt-1 block w-full border border-gray-300 rounded p-2 disabled:bg-gray-200">
                                        <option value="integer">Число (Integer)</option>
                                        <option value="numeric">Дробове (Numeric)</option>
                                        <option value="boolean">Так/Ні (Boolean)</option>
                                        <option value="text">Текст (Text)</option>
                                    </select>
                                </div>
                                <div>
                                    <label className="block text-sm font-medium text-gray-700">Порядок сортування</label>
                                    <input type="number" name="sort_order" value={formData.sort_order} onChange={handleInputChange} className="mt-1 block w-full border border-gray-300 rounded p-2" />
                                </div>
                            </div>

                            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label className="block text-sm font-medium text-gray-700">Група UI</label>
                                    <select name="ui_group" value={formData.ui_group} onChange={handleInputChange} className="mt-1 block w-full border border-gray-300 rounded p-2">
                                        {groups.map(g => (
                                            <option key={g.id} value={g.id}>{g.label_key}</option>
                                        ))}
                                    </select>
                                </div>
                                <div>
                                    <label className="block text-sm font-medium text-gray-700">UI Компонент</label>
                                    <select name="ui_component" value={formData.ui_component} onChange={handleInputChange} className="mt-1 block w-full border border-gray-300 rounded p-2">
                                        <option value="input_number">Input Number</option>
                                        <option value="input_text">Input Text</option>
                                        <option value="select">Select / Switch (Boolean)</option>
                                        <option value="textarea">Textarea</option>
                                    </select>
                                </div>
                            </div>

                            <div className="flex gap-6 p-4 bg-blue-50 rounded border border-blue-100">
                                <label className="flex items-center gap-2 text-sm font-medium text-gray-800 cursor-pointer">
                                    <input type="checkbox" name="is_visible_form" checked={formData.is_visible_form} onChange={handleInputChange} className="w-4 h-4 text-blue-600 rounded" />
                                    Показувати у формі редагування
                                </label>
                                <label className="flex items-center gap-2 text-sm font-medium text-gray-800 cursor-pointer">
                                    <input type="checkbox" name="is_visible_table" checked={formData.is_visible_table} onChange={handleInputChange} className="w-4 h-4 text-blue-600 rounded" />
                                    Показувати в таблиці результатів
                                </label>
                            </div>

                            <div>
                                <label className="flex justify-between items-end mb-1">
                                    <span className="block text-sm font-bold text-gray-700">Parser Config (JSON)</span>
                                    {jsonError && <span className="text-xs text-red-600 font-bold">{jsonError}</span>}
                                </label>
                                <textarea 
                                    name="parser_config" 
                                    value={formData.parser_config} 
                                    onChange={handleInputChange} 
                                    rows={8}
                                    className={`block w-full border ${jsonError ? 'border-red-500 bg-red-50' : 'border-gray-300 bg-gray-900 text-green-400'} rounded p-3 font-mono text-sm`}
                                    spellCheck="false"
                                />
                                <p className="text-xs text-gray-500 mt-1">Використовується рушієм парсера для отримання даних з OSM, GUS або Scraper.</p>
                            </div>

                            <div className="flex justify-end space-x-3 pt-4 border-t">
                                <button type="button" onClick={() => setIsModalOpen(false)} className="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded font-medium">Скасувати</button>
                                <button type="submit" disabled={isLoading} className="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 disabled:bg-blue-300 font-bold shadow-sm">{isLoading ? 'Збереження...' : 'Зберегти зміни'}</button>
                            </div>
                        </form>
                    </div>
                </div>
            )}
        </div>
    );
}
</file>

