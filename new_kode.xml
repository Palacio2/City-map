import React, { useState, useEffect } from 'react';
import { api } from '../../../../services/api';

export default function ScraperManager() {
    const [rules, setRules] = useState([]);
    const [isModalOpen, setIsModalOpen] = useState(false);
    const [isLoading, setIsLoading] = useState(false);
    const [isEditing, setIsEditing] = useState(false);

    const initialForm = {
        country_code: 'PL',
        platform: 'otodom',
        type: 'sale',
        item_selector: 'article',
        price_regex: '',
        sqm_regex: '',
        min_price: 0,
        max_price: 999999999,
        min_sqm: 0,
        max_sqm: 99999,
        is_active: true
    };
    const [formData, setFormData] = useState(initialForm);

    useEffect(() => { fetchRules(); }, []);

    const fetchRules = async () => {
        try {
            const data = await api.scraperRules.getAll();
            if (Array.isArray(data)) setRules(data);
        } catch (error) {
            console.error("Помилка завантаження правил:", error);
            setRules([]);
        }
    };

    const handleInputChange = (e) => {
        const { name, value, type, checked } = e.target;
        const val = type === 'checkbox' ? checked : value;
        setFormData({ ...formData, [name]: val });
    };

    const handleAddNew = () => {
        setFormData(initialForm);
        setIsEditing(false);
        setIsModalOpen(true);
    };

    const handleEdit = (rule) => {
        setFormData(rule);
        setIsEditing(true);
        setIsModalOpen(true);
    };

    const handleSubmit = async (e) => {
        e.preventDefault();
        setIsLoading(true);
        try {
            await api.scraperRules.save(formData);
            alert(isEditing ? "Правило оновлено!" : "Правило створено!");
            await fetchRules();
            setIsModalOpen(false);
        } catch (error) {
            alert(`Помилка: ${error.message}`);
        } finally {
            setIsLoading(false);
        }
    };

    const handleDelete = async (id) => {
        if (!window.confirm("Видалити це правило парсингу?")) return;
        try {
            await api.scraperRules.delete(id);
            await fetchRules();
        } catch (error) {
            alert(`Помилка: ${error.message}`);
        }
    };

    return (
        <div className="p-6 max-w-7xl mx-auto">
            <div className="flex justify-between items-center mb-6">
                <h1 className="text-2xl font-bold">Налаштування Скрапера Нерухомості</h1>
                <button onClick={handleAddNew} className="bg-purple-600 text-white px-4 py-2 rounded hover:bg-purple-700">
                    + Додати правило
                </button>
            </div>

            <div className="bg-white shadow rounded-lg overflow-x-auto">
                <table className="min-w-full text-left whitespace-nowrap">
                    <thead className="bg-gray-100">
                        <tr>
                            <th className="px-4 py-3">Платформа</th>
                            <th className="px-4 py-3">Тип</th>
                            <th className="px-4 py-3">CSS Селектор об'єкта</th>
                            <th className="px-4 py-3">Regex (Ціна)</th>
                            <th className="px-4 py-3">Ліміти (Ціна)</th>
                            <th className="px-4 py-3">Статус</th>
                            <th className="px-4 py-3">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        {rules.map(rule => (
                            <tr key={rule.id} className={`border-t ${!rule.is_active ? 'bg-gray-50 opacity-60' : ''}`}>
                                <td className="px-4 py-3 font-medium">
                                    <span className="bg-blue-100 text-blue-800 px-2 py-1 rounded text-xs mr-2">{rule.country_code}</span>
                                    {rule.platform}
                                </td>
                                <td className="px-4 py-3 text-sm font-semibold">{rule.type === 'sale' ? '🟢 Продаж' : '🔵 Оренда'}</td>
                                <td className="px-4 py-3 font-mono text-xs text-gray-600 bg-gray-50 rounded">{rule.item_selector}</td>
                                <td className="px-4 py-3 font-mono text-xs text-gray-600 max-w-[200px] truncate" title={rule.price_regex}>{rule.price_regex}</td>
                                <td className="px-4 py-3 text-xs text-gray-500">
                                    {rule.min_price} - {rule.max_price}
                                </td>
                                <td className="px-4 py-3 text-sm">
                                    {rule.is_active ? <span className="text-green-600">Активно</span> : <span className="text-red-500">Вимкнено</span>}
                                </td>
                                <td className="px-4 py-3">
                                    <button onClick={() => handleEdit(rule)} className="text-blue-500 hover:text-blue-700 mr-3">Змінити</button>
                                    <button onClick={() => handleDelete(rule.id)} className="text-red-500 hover:text-red-700">Видалити</button>
                                </td>
                            </tr>
                        ))}
                        {rules.length === 0 && (
                            <tr><td colSpan="7" className="text-center py-6 text-gray-500">Правил скрапінгу ще немає.</td></tr>
                        )}
                    </tbody>
                </table>
            </div>

            {isModalOpen && (
                <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
