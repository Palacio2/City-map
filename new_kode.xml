                                        className="mt-1 block w-full border border-gray-300 rounded p-2 uppercase" placeholder="PL або UA" />
                                </div>
                                <div>
                                    <label className="block text-sm font-medium text-gray-700">Платформа</label>
                                    <input required type="text" name="platform" value={formData.platform} onChange={handleInputChange} 
                                        className="mt-1 block w-full border border-gray-300 rounded p-2" placeholder="otodom, olx, dom_ria" />
                                </div>
                                <div>
                                    <label className="block text-sm font-medium text-gray-700">Тип нерухомості</label>
                                    <select name="type" value={formData.type} onChange={handleInputChange} className="mt-1 block w-full border border-gray-300 rounded p-2">
                                        <option value="sale">Продаж (Sale)</option>
                                        <option value="rent">Оренда (Rent)</option>
                                    </select>
                                </div>
                            </div>

                            <hr className="my-4" />
                            <h3 className="text-sm font-bold text-gray-800">Налаштування пошуку (DOM & Regex)</h3>

                            <div>
                                <label className="block text-sm font-medium text-gray-700">CSS Селектор одного оголошення (Item Selector)</label>
                                <input required type="text" name="item_selector" value={formData.item_selector} onChange={handleInputChange} 
                                    className="mt-1 block w-full border border-gray-300 rounded p-2 font-mono text-sm bg-gray-50" placeholder="article або .listing-item" />
                                <p className="text-xs text-gray-500 mt-1">Текст всередині цього селектора буде передано в Regex.</p>
                            </div>

                            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label className="block text-sm font-medium text-gray-700">Regex для Ціни (Група 1 = цифра)</label>
                                    <input required type="text" name="price_regex" value={formData.price_regex} onChange={handleInputChange} 
                                        className="mt-1 block w-full border border-gray-300 rounded p-2 font-mono text-sm" placeholder="([\d\s,]+)\s*zł" />
                                </div>
                                <div>
                                    <label className="block text-sm font-medium text-gray-700">Regex для Площі (за м²)</label>
                                    <input type="text" name="sqm_regex" value={formData.sqm_regex || ''} onChange={handleInputChange} 
                                        className="mt-1 block w-full border border-gray-300 rounded p-2 font-mono text-sm" placeholder="([\d\s,]+)\s*zł\s*\/\s*m" />
                                    <p className="text-xs text-gray-500 mt-1">Залиш пустим для оренди.</p>
                                </div>
                            </div>

                            <hr className="my-4" />
                            <h3 className="text-sm font-bold text-gray-800">Фільтрація аномалій (Ліміти)</h3>

                            <div className="grid grid-cols-2 gap-4">
                                <div>
                                    <label className="block text-xs font-bold text-gray-500">Мінімальна Ціна</label>
                                    <input required type="number" name="min_price" value={formData.min_price} onChange={handleInputChange} className="mt-1 block w-full border border-gray-300 rounded p-2" />
                                </div>
                                <div>
                                    <label className="block text-xs font-bold text-gray-500">Максимальна Ціна</label>
                                    <input required type="number" name="max_price" value={formData.max_price} onChange={handleInputChange} className="mt-1 block w-full border border-gray-300 rounded p-2" />
                                </div>
                                <div>
                                    <label className="block text-xs font-bold text-gray-500">Мінімум за м²</label>
                                    <input required type="number" name="min_sqm" value={formData.min_sqm} onChange={handleInputChange} className="mt-1 block w-full border border-gray-300 rounded p-2" />
                                </div>
                                <div>
                                    <label className="block text-xs font-bold text-gray-500">Максимум за м²</label>
                                    <input required type="number" name="max_sqm" value={formData.max_sqm} onChange={handleInputChange} className="mt-1 block w-full border border-gray-300 rounded p-2" />
                                </div>
                            </div>

                            <div className="flex items-center mt-4">
                                <input type="checkbox" id="is_active" name="is_active" checked={formData.is_active} onChange={handleInputChange} className="h-4 w-4 text-purple-600 focus:ring-purple-500 border-gray-300 rounded" />
                                <label htmlFor="is_active" className="ml-2 block text-sm text-gray-900">Правило активне (використовується парсером)</label>
                            </div>

                            <div className="flex justify-end space-x-3 pt-4 border-t mt-6">
                                <button type="button" onClick={() => setIsModalOpen(false)} className="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded">Скасувати</button>
                                <button type="submit" disabled={isLoading} className="bg-purple-600 text-white px-4 py-2 rounded hover:bg-purple-700 disabled:bg-purple-300">
                                    {isLoading ? 'Збереження...' : 'Зберегти'}
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            )}
        </div>
    );
}
</file>

