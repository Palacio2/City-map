// Маршрут для динамічного Sitemap
router.get("/sitemap.xml", async (req, res) => {
    try {
        // 1. Отримуємо всі міста з бази (це основні сторінки для Google)
        const { data: cities, error } = await supabase
            .from('cities')
            .select('name, countries(name)');

        if (error) throw error;

        const baseUrl = 'https://city-map-alpha.vercel.app';
        const now = new Date().toISOString().split('T')[0];

        // 2. Початок XML
        let xml = `<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    <url><loc>${baseUrl}/</loc><lastmod>${now}</lastmod><priority>1.0</priority></url>
    <url><loc>${baseUrl}/about</loc><lastmod>${now}</lastmod><priority>0.7</priority></url>
    <url><loc>${baseUrl}/faq</loc><lastmod>${now}</lastmod><priority>0.7</priority></url>
    <url><loc>${baseUrl}/subscription</loc><lastmod>${now}</lastmod><priority>0.8</priority></url>`;

        // 3. Додаємо всі міста
        cities.forEach(city => {
            const countryName = encodeURIComponent(city.countries.name);
            const cityName = encodeURIComponent(city.name);
            xml += `
    <url>
        <loc>${baseUrl}/map/${countryName}/${cityName}</loc>
        <lastmod>${now}</lastmod>
        <changefreq>weekly</changefreq>
        <priority>0.9</priority>
    </url>`;
        });

        xml += `\n</urlset>`;

        // 4. Відправляємо як XML файл
        res.header('Content-Type', 'application/xml');
        res.send(xml);
    } catch (e) {
        console.error("Sitemap error:", e);
        res.status(500).end();
    }
});