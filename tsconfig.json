{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",
    "ignoreDeprecations": "6.0",

    "types": ["vite/client", "@testing-library/jest-dom"],
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@api/*": ["src/shared/api/*"],
      "@services/*": ["src/services/*"],
      "@seo/*": ["src/seo/*"],
      "@layout/*": ["src/components/layout/*"],
      "@header/*": ["src/components/header/*"],
      "@footer/*": ["src/components/footer/*"],
      "@auth/*": ["src/pages/auth/*"],
      "@ui/*": ["src/shared/ui/*"],
      "@pages/*": ["src/pages/*"],
      "@hooks/*": ["src/shared/hooks/*"],
      "@supabaseClient": ["src/supabaseClient"],
      "@subscription/*": ["src/pages/subscription/*"],
      "@profile/*": ["src/pages/profile/*"],
      "@utils/*": ["src/shared/utils/*"],
      "@shared/*": ["src/shared/*"],
      "@modals/*": ["src/components/modals/*"],
      "@config/*": ["src/config/*"],
      "@cityCountrySelect/*": ["src/components/cityCountrySelect/*"],
      "@filtersPanel/*": ["src/components/filtersPanel/*"],
      "@districtMap/*": ["src/pages/districtMap/*"],
      "@stats/*": ["src/components/stats/*"],
      "@admin/*": ["src/pages/admin/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}