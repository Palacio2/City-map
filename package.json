{
  "name": "kvartals-client",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"cd server && npm run dev\"",
    "build": "npm run typecheck && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "pull-translations": "node scripts/pull_translations.mjs",
    "collect-keys": "node scripts/collect_translation_keys.mjs",
    "sync-translations": "node scripts/sync_translations_db.mjs",
    "sync-translations:dry": "node scripts/sync_translations_db.mjs --dry-run",
    "extract-keys": "node src/pages/admin/features/translations/extract-keys.mjs",
    "test:security": "node scripts/check-security.mjs",
    "typecheck": "tsc --noEmit",
    "test:run": "vitest run",
    "check": "npm run lint && npm run test:run && npm run test:security && npm run build",
    "check:edge": "node scripts/check-edge.mjs",
    "check:db:clean": "node scripts/check-clean-db.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@sentry/react": "^10.42.0",
    "@supabase/supabase-js": "^2.112.2",
    "@tanstack/react-query": "^5.94.5",
    "@tanstack/react-virtual": "^3.14.9",
    "@turf/turf": "^7.3.4",
    "browser-image-compression": "^2.0.2",
    "dotenv": "^17.4.2",
    "html2canvas-pro": "^2.5.2",
    "i18next": "^25.8.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^4.0.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.72.0",
    "react-i18next": "^16.5.4",
    "react-icons": "^5.0.0",
    "react-leaflet": "^4.2.1",
    "react-leaflet-cluster": "^3.1.1",
    "react-markdown": "^10.1.0",
    "react-phone-number-input": "^3.4.16",
    "react-router-dom": "^7.18.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^8.57.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.4",
    "deno": "2.9.6",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.0.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^6.4.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
