            {error && <div className="text-danger bg-danger/10 p-4 rounded-xl border border-danger/20 text-sm text-center mb-6 font-medium">{error}</div>}
            {clientSecret ? (
              <Elements key={clientSecret} options={options} stripe={stripePromise}>
