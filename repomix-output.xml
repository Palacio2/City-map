@import url('https://fonts.googleapis.com/css2?family=Lora:wght@400;500;600;700&family=Manrope:wght@300;400;500;600&display=swap');

:root {
  --font-heading: 'Lora', serif;
  --font-body: 'Manrope', sans-serif;
  --primary-color: #0f1014;
  --primary-gradient: linear-gradient(135deg, #0f1014 0%, #2c2e35 100%);
  --primary-light: #2c2e35;
  --accent-color: #c5a47e;
  --accent-hover: #d4b895;
  --danger-color: #ef4444;
  --success-color: #22c55e;
  --warning-color: #eab308;
  --bg-body: #f4f5f7;
  --bg-surface: #ffffff;
  --bg-footer: #0f1014;
  --bg-hover: #e2e8f0;
  --glass-bg: rgba(255, 255, 255, 0.9);
  --glass-border: rgba(255, 255, 255, 0.6);
  --glass-blur: 16px;
  --text-main: #0f172a;
  --text-secondary: #475569;
  --text-inverse: #ffffff;
  --text-inverse-secondary: #94a3b8;
  --border-color: rgba(0, 0, 0, 0.06);
  --border-accent: rgba(197, 164, 126, 0.4);
  --header-height: 80px;
  --safe-top: env(safe-area-inset-top, 0px);
  --safe-bottom: env(safe-area-inset-bottom, 0px);
  --safe-left: env(safe-area-inset-left, 0px);
  --safe-right: env(safe-area-inset-right, 0px);
  --z-base: 1;
  --z-dropdown: 100;
  --z-sticky: 200;
  --z-fixed: 1000;
  --z-sidebar: 2000;
  --z-modal-overlay: 9998;
  --z-modal: 9999;
  --z-tooltip: 10000;
  --z-toast: 100000;
  --spacing-xs: 0.25rem;
  --spacing-sm: 0.5rem;
  --spacing-md: 1rem;
  --spacing-lg: 2rem;
  --spacing-xl: 4rem;
  --radius-sm: 6px;
  --radius-md: 12px;
  --radius-lg: 24px;
  --radius-full: 9999px;
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.04);
  --shadow-card: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
  --shadow-hover: 0 20px 25px -5px rgba(0, 0, 0, 0.05), 0 10px 10px -5px rgba(0, 0, 0, 0.02);
  --shadow-glass: 0 8px 32px 0 rgba(31, 38, 135, 0.05);
  --shadow-modal: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  --transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

[data-theme='dark'] {
  --primary-color: #f8fafc;
  --primary-gradient: linear-gradient(135deg, #e2e8f0 0%, #94a3b8 100%);
  --primary-light: #1e293b;
  --bg-body: #111318;
  --bg-surface: #1a1d24;
  --bg-footer: #0b0c10;
  --bg-hover: #232730;
  --glass-bg: rgba(26, 29, 36, 0.8);
  --glass-border: rgba(255, 255, 255, 0.05);
  --text-main: #f1f5f9;
  --text-secondary: #94a3b8;
  --border-color: rgba(255, 255, 255, 0.06);
  --shadow-card: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
  --shadow-hover: 0 10px 15px -3px rgba(0, 0, 0, 0.4);
  --shadow-glass: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
}

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  -webkit-tap-highlight-color: transparent;
}

html {
  font-size: 100%;
  scroll-behavior: smooth;
  text-size-adjust: 100%;
}

body {
  font-family: var(--font-body);
  background-color: var(--bg-body);
  color: var(--text-main);
  line-height: 1.6;
  min-height: 100vh;
  min-height: 100dvh;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-heading);
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -0.02em;
  margin-bottom: var(--spacing-md);
}

p {
  margin-bottom: var(--spacing-md);
}

label {
  display: block;
  font-weight: 500;
  margin-bottom: var(--spacing-sm);
  color: var(--text-secondary);
}

input, select, textarea, button {
  font-family: inherit;
  font-size: 100%;
  border: none;
  outline: none;
}

a {
  text-decoration: none;
  color: inherit;
  transition: var(--transition);
}

button {
  background: none;
  cursor: pointer;
}

:focus-visible {
  outline: 2px solid var(--accent-color);
  outline-offset: 2px;
}

::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background-color: var(--border-accent);
  border-radius: 99px;
  border: 2px solid transparent;
  background-clip: content-box;
}

::-webkit-scrollbar-thumb:hover {
  background-color: var(--accent-color);
}

@media (max-width: 768px) {
  :root {
    --header-height: 64px;
    --spacing-xl: 2rem;
    --spacing-lg: 1.5rem;
  }
  
  h1 { font-size: 1.75rem; }
  h2 { font-size: 1.5rem; }
}

@media (prefers-reduced-motion: reduce) {
  * {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
